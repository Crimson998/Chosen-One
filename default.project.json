        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 4
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 17.3,
        "Brightness": 2.5,
        "GlobalShadows": true
      }
