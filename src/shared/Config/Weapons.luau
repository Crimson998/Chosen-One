Weapons.List = defs
Weapons.ById = {} :: { [string]: WeaponDef }
for _, def in defs do
	Weapons.ById[def.Id] = def
end

-- Every new profile owns these and has them equipped.
Weapons.DefaultLoadout = {
	Primary = "Viper",
	Secondary = "P9",
}

function Weapons.Get(id: any): WeaponDef?
	if typeof(id) ~= "string" then
		return nil
	end
	return Weapons.ById[id]
end

-- Seconds between two shots (within a burst for burst weapons).
function Weapons.FireInterval(def: WeaponDef): number
	return 60 / def.RPM
end

-- Total carried weight of a loadout in kg.
function Weapons.LoadoutWeight(primaryId: string?, secondaryId: string?): number
	local total = 0
	for _, id in { primaryId, secondaryId } do
		local def = Weapons.Get(id)
		if def then
			total += def.Weight
		end
	end
	return total
end

return Weapons
