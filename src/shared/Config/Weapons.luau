--!strict
-- Weapon definitions. Every gameplay number for guns lives here; the server
-- validates against these values and the client uses them for prediction.

export type FireMode = "Auto" | "Semi" | "Burst"
export type Slot = "Primary" | "Secondary"
-- Solid rounds hit players at full strength. Optical (laser) guns are light
-- and accurate but mostly absorbed by the anti-bullet fields players wear.
-- Blades are melee energy weapons.
export type AmmoType = "Solid" | "Optical" | "Blade"
export type ModelStyle =
	"Pistol"
	| "MachinePistol"
	| "Revolver"
	| "SMG"
	| "Rifle"
	| "Shotgun"
	| "DMR"
	| "Sniper"
	| "LMG"
	| "PDW"
	| "AMR"
	| "Minigun"
	| "Blaster"
	| "OpticalRifle"
	| "Blade"

export type WeaponDef = {
	Id: string,
	DisplayName: string,
	Class: string,
	Description: string,
	Slot: Slot,
	Price: number,
	LevelRequired: number,
	Ammo: AmmoType,
	Weight: number, -- kg; see Attributes.CarryCapacity
	RequiredSTR: number, -- below this, recoil and spread suffer

	Damage: number, -- per pellet
	HeadshotMultiplier: number,
	FalloffStart: number, -- studs
	FalloffEnd: number,
	MinDamageRatio: number, -- damage multiplier at/after FalloffEnd
	Range: number,

	FireMode: FireMode,
	RPM: number, -- for Burst this is the in-burst rate
	BurstCount: number?,
	BurstDelay: number?, -- seconds between bursts
	Pellets: number,

	MagSize: number,
	ReserveAmmo: number,
	ReloadTime: number,

	HipSpread: number, -- degrees
	AimSpread: number,
	SpreadPerShot: number, -- bloom added per shot
	MaxBloom: number,
	RecoilKick: number, -- degrees of vertical camera kick per shot
	RecoilSide: number, -- max degrees of horizontal kick per shot

	AimFOV: number,
	AimTime: number, -- seconds to fully aim down sights
	Scoped: boolean?,
	MoveSpeedMultiplier: number,
	Melee: boolean?, -- short-range swing: Pellets rays fanned horizontally, no ammo
	DropOnly: boolean?, -- not sold in the Armory; only found as loot
	SpinUp: number?, -- seconds the trigger must be held before it fires (miniguns)

	Model: {
		Style: ModelStyle,
		Body: Color3,
		Accent: Color3,
	},
	Sound: string, -- key into Config.Sounds (prefixed with "Fire_")
}

